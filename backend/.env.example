# NeuroX backend environment template
# Copy to backend/.env for local development. Never commit real values.

APP_ENV=development
DATABASE_URL=postgresql+psycopg://neurox:neurox@localhost:5432/neurox
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT_SECONDS=30
DATABASE_POOL_RECYCLE_SECONDS=1800

# Authentication and token security
JWT_SECRET=replace-with-a-long-random-secret
# JWT_SECRET_FILE=/run/secrets/jwt-secret
JWT_KEY_ID=current
JWT_PREVIOUS_SECRETS=
RATE_LIMIT_KEY=replace-with-a-separate-long-random-secret
# RATE_LIMIT_KEY_FILE=/run/secrets/rate-limit-key
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=14
ACCOUNT_TOKEN_RETENTION_DAYS=7
SESSION_RETENTION_DAYS=30
BCRYPT_ROUNDS=12
REQUIRE_EMAIL_VERIFICATION=false
RATE_LIMIT_ENABLED=false
LOG_LEVEL=INFO

# Browser security and API operations
CORS_ORIGINS=http://localhost:5173
PUBLIC_WEB_URL=http://localhost:5173
BROWSER_COOKIE_SAMESITE=strict
REDIS_URL=redis://localhost:6379/0
# For Upstash, leave REDIS_URL empty and set these instead:
# UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
# UPSTASH_REDIS_REST_TOKEN=replace-with-upstash-token
# UPSTASH_REDIS_REST_TOKEN_FILE=/run/secrets/upstash-redis-token
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
MAINTENANCE_INTERVAL_SECONDS=3600

# Google OAuth (server-side verification uses the web client ID)
GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-web-client-id.apps.googleusercontent.com

# Firebase / FCM
FCM_ENABLED=false
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_SERVICE_ACCOUNT_JSON=
# FIREBASE_SERVICE_ACCOUNT_JSON_FILE=/run/secrets/firebase.json
FCM_TIMEOUT_SECONDS=10
FCM_DEVICE_TOKEN_TTL_DAYS=90

# Transactional email
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=no-reply@neurox.local
SMTP_STARTTLS=false
SMTP_USERNAME=
SMTP_PASSWORD=
# SMTP_PASSWORD_FILE=/run/secrets/smtp-password

# SMS provider webhook
SMS_GATEWAY_URL=https://sms-provider.example/messages
SMS_GATEWAY_TOKEN=replace-with-provider-token
# SMS_GATEWAY_TOKEN_FILE=/run/secrets/sms-gateway-token

# BHASHINI / ULCA speech-to-text
BHASHINI_ENABLED=false
BHASHINI_USER_ID=
BHASHINI_API_KEY=
# BHASHINI_API_KEY_FILE=/run/secrets/bhashini-api-key
BHASHINI_PIPELINE_ID=
BHASHINI_CONFIG_URL=https://meity-auth.ulcacontrib.org/ulca/apis/v0/model/getModelsPipeline
BHASHINI_INFERENCE_URL=https://dhruva-api.bhashini.gov.in/services/inference/pipeline
BHASHINI_TIMEOUT_SECONDS=20
BHASHINI_MAX_AUDIO_SECONDS=30

# Optional remote Whisper-compatible fallback
WHISPER_ENABLED=false
WHISPER_BASE_URL=
WHISPER_API_KEY=
# WHISPER_API_KEY_FILE=/run/secrets/whisper-api-key
WHISPER_TIMEOUT_SECONDS=20

# Verified LASI research model
COGNITIVE_MODEL_PATH=../models/lasi_baseline/lasi_low_recall_calibrated.joblib
COGNITIVE_MODEL_SHA256=

# Notification worker safeguards
DELIVERY_MAX_ATTEMPTS=5
DELIVERY_RETRY_BACKOFF_SECONDS=10
NOTIFICATION_OUTBOX_ENABLED=false

# Development-only fixtures
SEED_DEMO_DATA=true
DEMO_CAREGIVER_EMAIL=anita@neurox.demo
DEMO_CAREGIVER_PASSWORD=replace-with-a-local-only-password
DEMO_PATIENT_EMAIL=maya@neurox.demo
DEMO_PATIENT_PASSWORD=replace-with-a-local-only-password
