# NeuroX caregiver dashboard environment template
# Copy to web/caregiver-dashboard/.env.local for local development.
# Vite exposes VITE_* values to the browser; never put backend secrets here.

# Do not add a trailing slash. The client also normalizes it defensively.
VITE_API_BASE_URL=http://localhost:8000
VITE_GOOGLE_CLIENT_ID=your-google-oauth-web-client-id.apps.googleusercontent.com
